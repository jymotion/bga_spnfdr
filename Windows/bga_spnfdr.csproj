<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>bga_spnfdr</AssemblyName>
    <RootNamespace>BgaSpnfdr</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Company>bga_spnfdr</Company>
    <Product>bga_spnfdr</Product>
    <Description>Displays BattleTanx: Global Assault route notes based on the on-screen score</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- TextFieldParser for route CSVs with quoted multi-line notes (in-box) -->
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <!-- Windows.Graphics.Capture build (dotnet build ... -p:GraphicsCapture=true):
       captures with Windows.Graphics.Capture and reads 30 times a second,
       copying only the score strip back from the graphics card each read
       (a full frame ~10 times a second, only while the setup window shows it
       or auto-crop needs it). Falls back to PrintWindow at 10 reads a second,
       as in the normal build, before Windows 10 version 1903 or if it fails.
       Not adopted yet: the normal build is unaffected (the code is compiled
       out and the WinRT reference is only added here). -->
  <PropertyGroup Condition="'$(GraphicsCapture)' == 'true' Or '$(PerfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);GRAPHICS_CAPTURE</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="'$(GraphicsCapture)' == 'true' Or '$(PerfTest)' == 'true'">
    <!-- WinRT projections for Windows.Graphics.Capture. Build-time only:
         .NET Framework calls WinRT itself, so the exe stays a single file. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.2428" />
  </ItemGroup>

  <!-- 30-reads-a-second test build (dotnet build ... -p:PerfTest=true):
       rotates each minute between PrintWindow at 30 reads/s, Windows.Graphics.
       Capture at 30/s and PrintWindow at 10/s (today's app), and logs CPU,
       timings and confirmed scores per method. -->
  <PropertyGroup Condition="'$(PerfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);PERF_TEST</DefineConstants>
    <AssemblyName>bga_spnfdr_30fps_test</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Platform-neutral logic shared with the Linux build, compiled straight
         into this exe (no extra DLL). This project only ever sees Windows/
         and Core/; nothing Linux-specific can end up in the Windows build. -->
    <Compile Include="..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
