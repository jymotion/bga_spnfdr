<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>bga_spnfdr</AssemblyName>
    <RootNamespace>BgaSpnfdr</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.0</Version>
    <Company>bga_spnfdr</Company>
    <Product>bga_spnfdr</Product>
    <Description>Displays BattleTanx: Global Assault route notes based on the on-screen score</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Direct3D 11 is called through its function tables (Windows/GraphicsCapture.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- WinRT projections for Windows.Graphics.Capture. Build-time only:
         .NET Framework calls WinRT itself, so the exe stays a single file. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.2428" />
  </ItemGroup>

  <!-- Capture test build (dotnet build ... -p:PerfTest=true): rotates each
       minute between PrintWindow at 30 reads/s, Windows.Graphics.Capture at
       30/s and PrintWindow at 10/s, and logs CPU, timings and confirmed
       scores per method. The normal build is unaffected (the extra code is
       compiled out). -->
  <PropertyGroup Condition="'$(PerfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);PERF_TEST</DefineConstants>
    <AssemblyName>bga_spnfdr_30fps_test</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Platform-neutral logic shared with the Linux build, compiled straight
         into this exe (no extra DLL). This project only ever sees Windows/
         and Core/; nothing Linux-specific can end up in the Windows build. -->
    <Compile Include="..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
