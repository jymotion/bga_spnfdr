<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>bga_spnfdr</AssemblyName>
    <RootNamespace>BgaSpnfdr</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Company>bga_spnfdr</Company>
    <Product>bga_spnfdr</Product>
    <Description>Displays BattleTanx: Global Assault route notes based on the on-screen score</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- TextFieldParser for route CSVs with quoted multi-line notes (in-box) -->
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <!-- 30-reads-a-second test build (dotnet build ... -p:PerfTest=true): reads
       like the Linux build (30/s, 3-read rule), alternating with 10/s each
       minute, and logs CPU and timings. The normal build is unaffected (the
       extra code is compiled out). -->
  <PropertyGroup Condition="'$(PerfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);PERF_TEST;READ_EVERY_FRAME</DefineConstants>
    <AssemblyName>bga_spnfdr_30fps_test</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Platform-neutral logic shared with the Linux build, compiled straight
         into this exe (no extra DLL). This project only ever sees Windows/
         and Core/; nothing Linux-specific can end up in the Windows build. -->
    <Compile Include="..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
