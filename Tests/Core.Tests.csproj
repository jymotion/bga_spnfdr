<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the shared Core/ logic. Not part of either app's build.
       Targets plain .NET 8 with no Windows libraries, so it also proves
       Core/ still builds for Linux. Run with: dotnet test Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>BgaSpnfdr.Tests</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Core/DigitReader reads through pointers (Vector4) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
